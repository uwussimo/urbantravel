# Telegram bot that receives booking requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel (/admin) password — required for the admin panel to work
ADMIN_PASSWORD=

# Optional: separate secret for signing admin session cookies
# (falls back to ADMIN_PASSWORD when unset)
ADMIN_SESSION_SECRET=

# Vercel Blob storage for tours data and photo uploads.
# Auto-injected on Vercel after you create a Blob store (Storage → Create → Blob).
# Leave empty locally — dev falls back to .data/tours.json and public/uploads/.
BLOB_READ_WRITE_TOKEN=

# Optional analytics — rendered only when set
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
